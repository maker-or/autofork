{
  "name": "autofork",
  "version": "0.1.4",
  "description": "Customized forks that maintain themselves. Personal forks of open-source apps auto-track upstream: every release, your changes are reapplied, and an agent rebuilds any that break.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://autofork.com",
  "repository": "github:AVGVSTVS96/autofork",
  "bin": {
    "autofork": "dist/autofork.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/autofork.ts --target node --outfile dist/autofork.js",
    "test": "bun run build && bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
